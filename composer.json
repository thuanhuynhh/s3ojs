{
    "name": "ojs/s3-storage-plugin",
    "description": "Amazon S3 Storage Plugin for Open Journal Systems 3.4.0",
    "type": "ojs-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "OJS Community",
            "email": "pkp-support@sfu.ca"
        }
    ],
    "require": {
        "php": ">=7.3.0",
        "aws/aws-sdk-php": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "APP\\plugins\\generic\\s3Storage\\": ""
        }
    },
    "extra": {
        "ofb": {
            "name": "s3Storage",
            "class": "S3StoragePlugin"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
} 